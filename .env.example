# ==============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE — MÉTODO ACORDO 90
# Copie este arquivo para .env e preencha com as suas chaves e URLs reais.
# ==============================================================================

# AMBIENTE
NODE_ENV=production
VERCEL_ENV=production

# ------------------------------------------------------------------------------
# 1. CHECKOUT & PRODUTO (CAKTO)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CHECKOUT_URL=https://pay.cakto.com.br/SEU_CHECKOUT_AQUI
CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/SEU_CHECKOUT_AQUI

NEXT_PUBLIC_PRODUCT_NAME=Método Acordo 90
NEXT_PUBLIC_PRODUCT_PRICE=24.90
NEXT_PUBLIC_PRODUCT_PRICE_FORMATTED=R$ 24,90
NEXT_PUBLIC_PRODUCT_CURRENCY=BRL

CAKTO_API_KEY=sua_chave_de_api_cakto_aqui
CAKTO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ------------------------------------------------------------------------------
# 2. TRACKING & TRÁFEGO PAGO (PIXELS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=seu_meta_pixel_id_aqui
META_PIXEL_ACCESS_TOKEN=seu_access_token_da_api_de_conversoes_aqui

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# 3. SUPORTE & ATENDIMENTO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@metodoacordo90.com.br
NEXT_PUBLIC_SUPPORT_WHATSAPP=
