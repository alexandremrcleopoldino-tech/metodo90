# AMBIENTE
NODE_ENV=production
VERCEL_ENV=production

# ------------------------------------------------------------------------------
# 1. CHECKOUT & PRODUTO (CAKTO)
# ------------------------------------------------------------------------------
# Link oficial do checkout configurado na Cakto
NEXT_PUBLIC_CHECKOUT_URL=https://pay.cakto.com.br/33hxfwd_1259544
CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/33hxfwd_1259544

# Dados comerciais do produto
NEXT_PUBLIC_PRODUCT_NAME=Método Acordo 90
NEXT_PUBLIC_PRODUCT_PRICE=24.90
NEXT_PUBLIC_PRODUCT_PRICE_FORMATTED=R$ 24,90
NEXT_PUBLIC_PRODUCT_CURRENCY=BRL

# Tokens e segredos da Cakto (para webhooks / pós-venda)
CAKTO_API_KEY=
CAKTO_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. TRACKING & TRÁFEGO PAGO (PIXELS)
# ------------------------------------------------------------------------------
# Meta Pixel ID (Facebook Ads / Instagram Ads)
NEXT_PUBLIC_META_PIXEL_ID=2152210728708890
META_PIXEL_ACCESS_TOKEN=

# Google Analytics 4 (GA4) - Opcional
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# TikTok Pixel ID - Opcional
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Google Tag Manager (GTM) - Opcional
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# 3. SUPORTE & ATENDIMENTO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@metodoacordo90.com.br
NEXT_PUBLIC_SUPPORT_WHATSAPP=
